# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here-change-this

# Firebase Admin SDK Configuration
# IMPORTANT: This project uses Firebase ADMIN SDK (server-side), not Web SDK
# 
# To get these credentials:
# 1. Go to: https://console.firebase.google.com/project/whatsapp-automation-a8d2d/settings/serviceaccounts/adminsdk
# 2. Click "Generate new private key"
# 3. Download the JSON file
# 4. Copy the values from JSON to below:
#    - project_id → FIREBASE_PROJECT_ID
#    - private_key → FIREBASE_PRIVATE_KEY (keep the \n characters!)
#    - client_email → FIREBASE_CLIENT_EMAIL

FIREBASE_PROJECT_ID=whatsapp-automation-a8d2d
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@whatsapp-automation-a8d2d.iam.gserviceaccount.com

# WhatsApp Automation Settings
MIN_DELAY_SECONDS=15
MAX_DELAY_SECONDS=30

# Server Configuration
PORT=5000
DEBUG=false
